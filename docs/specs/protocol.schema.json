{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirescape-lab.invalid/protocol-v0.schema.json",
  "title": "Wirescape implemented protocol v0 — unwired validation schema",
  "description": "Only shape known from sidecar v0; unknown patch document keys remain accepted. Line-size, duplicate-key, nesting and queue policy are separately tested.",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/reply"
    },
    {
      "$ref": "#/$defs/push"
    }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[\\x20-\\x7E]*$"
    },
    "gen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "moduleId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "parameters": {
      "type": "object"
    },
    "ccRow": {
      "type": "object",
      "required": [
        "channel",
        "controller"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "controller": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "fourteen_bit": {
          "type": "boolean"
        },
        "bipolar": {
          "type": "boolean"
        },
        "smoothing_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "module",
        "port"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/moduleId"
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "enum": [
            "signal",
            "event",
            "modulation"
          ]
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "amount": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "patchModule": {
      "type": "object",
      "required": [
        "id",
        "module"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/moduleId"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "config": {
          "type": "object"
        },
        "state": {
          "type": "object"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "patch": {
      "type": "object",
      "required": [
        "format",
        "version",
        "modules",
        "connections"
      ],
      "properties": {
        "format": {
          "const": "wirescape.native.patch"
        },
        "version": {
          "const": 2
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patchModule"
          },
          "maxItems": 64
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          },
          "maxItems": 128
        },
        "settings": {
          "type": "object"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "port",
              "bus_channel"
            ],
            "properties": {
              "module": {
                "$ref": "#/$defs/moduleId"
              },
              "port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "bus_channel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            }
          },
          "maxItems": 128
        },
        "ui": {
          "type": "object"
        }
      }
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "audio",
            "midi"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "system_name": {
          "type": "string",
          "maxLength": 256
        },
        "sampleRates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 32
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "hostApi": {
          "type": "string",
          "maxLength": 128
        },
        "backend": {
          "type": "string",
          "maxLength": 128
        },
        "outputChannels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "supported": {
          "type": "boolean"
        },
        "unsupportedReason": {
          "enum": [
            "mono-output",
            "no-output",
            "rate-unsupported"
          ]
        },
        "defaultSampleRate": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "state",
        "deviceId",
        "deviceName",
        "sampleRate",
        "bufferFrames",
        "latencyMs",
        "cpuPercent",
        "dropouts"
      ],
      "properties": {
        "state": {
          "enum": [
            "starting",
            "running",
            "no-device",
            "device-lost",
            "reconnecting"
          ]
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviceName": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "bufferFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "cpuPercent": {
          "type": "number",
          "minimum": 0
        },
        "dropouts": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        },
        "error": {
          "type": "string",
          "maxLength": 200
        },
        "requestedBufferFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "midiLearnStatus": {
      "type": "object",
      "required": [
        "armed"
      ],
      "properties": {
        "armed": {
          "const": true
        },
        "seq": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "controller": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "midiCounters": {
      "type": "object",
      "required": [
        "received",
        "dropped",
        "malformed",
        "oversize",
        "ring_full",
        "disconnects",
        "send_fail",
        "ignored_rpn",
        "release_panics",
        "ports"
      ],
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        },
        "malformed": {
          "type": "integer",
          "minimum": 0
        },
        "oversize": {
          "type": "integer",
          "minimum": 0
        },
        "ring_full": {
          "type": "integer",
          "minimum": 0
        },
        "disconnects": {
          "type": "integer",
          "minimum": 0
        },
        "send_fail": {
          "type": "integer",
          "minimum": 0
        },
        "ignored_rpn": {
          "type": "integer",
          "minimum": 0
        },
        "release_panics": {
          "type": "integer",
          "minimum": 0
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "system_name",
              "received",
              "online"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "system_name": {
                "type": "string",
                "maxLength": 256
              },
              "received": {
                "type": "integer",
                "minimum": 0
              },
              "online": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "midi": {
      "type": "object",
      "required": [
        "devices",
        "activity"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          },
          "maxItems": 256
        },
        "activity": {
          "type": "object"
        },
        "learn": {
          "$ref": "#/$defs/midiLearnStatus"
        },
        "counters": {
          "$ref": "#/$defs/midiCounters"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "audio",
        "midi"
      ],
      "properties": {
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "midi": {
          "$ref": "#/$defs/midi"
        },
        "osc": {
          "type": "object",
          "properties": {
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "budget_dropped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "enqueue_dropped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "listener_budget_dropped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "listener_enqueue_dropped": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "clock": {
          "type": "object"
        }
      }
    },
    "catalogue": {
      "type": "object",
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category",
              "ports",
              "parameters"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "category": {
                "type": "string",
                "maxLength": 128
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "direction",
                    "kind",
                    "hint",
                    "poly",
                    "stereo_pair"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "direction": {
                      "enum": [
                        "input",
                        "output"
                      ]
                    },
                    "kind": {
                      "enum": [
                        "signal",
                        "event"
                      ]
                    },
                    "hint": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "poly": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "stereo_pair": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "maxItems": 128
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "minimum",
                    "maximum",
                    "default",
                    "unit",
                    "taper",
                    "step",
                    "decimals",
                    "modulatable"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "default": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "taper": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "step": {
                      "type": "number"
                    },
                    "decimals": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16
                    },
                    "modulatable": {
                      "type": "boolean"
                    }
                  }
                },
                "maxItems": 256
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "patch"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "loadGraph"
            },
            "patch": {
              "$ref": "#/$defs/patch"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "patch"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "applyGraph"
            },
            "patch": {
              "$ref": "#/$defs/patch"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "moduleId",
            "moduleType"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "addModule"
            },
            "moduleId": {
              "$ref": "#/$defs/moduleId"
            },
            "moduleType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "params": {
              "$ref": "#/$defs/parameters"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "moduleId"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "removeModule"
            },
            "moduleId": {
              "$ref": "#/$defs/moduleId"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "connection"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "connect"
            },
            "connection": {
              "$ref": "#/$defs/connection"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "connection"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "disconnect"
            },
            "connection": {
              "$ref": "#/$defs/connectionIdentity"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "moduleId",
            "paramId",
            "value"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setParam"
            },
            "moduleId": {
              "$ref": "#/$defs/moduleId"
            },
            "paramId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "moduleId",
            "slot",
            "value"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setData"
            },
            "moduleId": {
              "$ref": "#/$defs/moduleId"
            },
            "slot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "value": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "connection",
            "amount"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setModAmount"
            },
            "connection": {
              "$ref": "#/$defs/connectionIdentity"
            },
            "amount": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "note",
            "velocity"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "noteOn"
            },
            "note": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "velocity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "note"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "noteOff"
            },
            "note": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "panic"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "listAudioDevices"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "deviceId"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "selectAudioDevice"
            },
            "deviceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "listMidiDevices"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "deviceId",
            "on"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setMidiEnabled"
            },
            "deviceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "on": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "armed"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "midiLearn"
            },
            "armed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "hz"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setSampleRate"
            },
            "hz": {
              "type": "integer",
              "enum": [
                44100,
                48000,
                96000
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
            "type",
            "frames"
          ],
          "properties": {
            "v": {
              "const": 0
            },
            "id": {
              "$ref": "#/$defs/requestId"
            },
            "type": {
              "const": "setBufferFrames"
            },
            "frames": {
              "type": "integer",
              "enum": [
                64,
                128,
                256,
                512,
                1024
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "v",
            "id",
