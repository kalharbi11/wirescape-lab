{
  "SPDX-License-Identifier": "GPL-3.0-only",
  "format": "wirescape.native.patch",
  "version": 2,
  "settings": {
    "sample_rate": 48000,
    "max_block_frames": 256,
    "max_channels": 16,
    "feedback_block": 32,
    "seed": 147,
    "timing_mode": "immediate"
  },
  "ui": {},
  "name": "Compare B 8-voice MIDI oscillator filter envelope",
  "description": "Eight MIDI voices; each note drives one oscillator, filter, ADSR, VCA",
  "modules": [
    {
      "id": 1,
      "module": "midi.in",
      "version": 1,
      "parameters": {},
      "config": {
        "endpoint": "all_enabled"
      }
    },
    {
      "id": 2,
      "module": "midi.to_cv",
      "version": 1,
      "parameters": {
        "voice_count": 8,
        "allocation_mode": 0,
        "apply_bend": 0,
        "channel_filter": 0
      }
    },
    {
      "id": 3,
      "module": "essentials.vco",
      "version": 2,
      "parameters": {
        "frequency": 220
      }
    },
    {
      "id": 4,
      "module": "essentials.vcf",
      "version": 2,
      "parameters": {
        "cutoff": 1800,
        "resonance": 0.15
      }
    },
    {
      "id": 5,
      "module": "essentials.adsr",
      "version": 2,
      "parameters": {
        "attack": 0.015,
        "decay": 0.14,
        "sustain": 0.65,
        "release": 0.2
      }
    },
    {
      "id": 6,
      "module": "essentials.vca",
      "version": 2,
      "parameters": {
        "gain": 0.02
      }
    },
    {
      "id": 7,
      "module": "essentials.output",
      "version": 2,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "kind": "event",
      "from": {
        "module": 1,
        "port": "midi"
      },
      "to": {
        "module": 2,
        "port": "midi"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 2,
        "port": "pitch"
      },
      "to": {
        "module": 3,
        "port": "pitch"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 2,
        "port": "gate"
      },
      "to": {
        "module": 5,
        "port": "gate"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 3,
        "port": "audio"
      },
      "to": {
        "module": 4,
        "port": "audio"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 4,
        "port": "low24"
      },
      "to": {
        "module": 6,
        "port": "audio"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 5,
        "port": "envelope"
      },
      "to": {
        "module": 6,
        "port": "gain_cv"
      }
    },
    {
      "kind": "signal",
      "from": {
        "module": 6,
        "port": "audio"
      },
      "to": {
        "module": 7,
        "port": "audio"
      }
    }
  ],
  "outputs": [
    {
      "module": 7,
      "port": "audio",
      "bus_channel": 0
    },
    {
      "module": 7,
      "port": "audio",
      "bus_channel": 1
    }
  ]
}
