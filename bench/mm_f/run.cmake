# ctest -S bench/mm_f/run.cmake -V (available-module-only diagnostic)
cmake_minimum_required(VERSION 3.20)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(CTEST_SOURCE_DIRECTORY "${repo}/native")
set(CTEST_BINARY_DIRECTORY "${repo}/build/mm_f")
set(CTEST_CMAKE_GENERATOR Ninja)
ctest_start(Experimental)
function(checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "MM-f command failed: ${rc}")
  endif()
endfunction()
checked("${CMAKE_COMMAND}" -S "${CTEST_SOURCE_DIRECTORY}" -B "${CTEST_BINARY_DIRECTORY}" -G Ninja
  -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PROJECT_INCLUDE=${CMAKE_CURRENT_LIST_DIR}/hook.cmake")
checked("${CMAKE_COMMAND}" --build "${CTEST_BINARY_DIRECTORY}" --target mm_f_probe --parallel 2)
checked(git -C "${repo}" rev-parse HEAD)
checked(uname -smr)
checked(date -u +%Y-%m-%dT%H:%M:%SZ)
file(STRINGS "${CTEST_BINARY_DIRECTORY}/CMakeCache.txt" compiler REGEX "^CMAKE_CXX_COMPILER:FILEPATH=")
string(REPLACE "CMAKE_CXX_COMPILER:FILEPATH=" "" compiler "${compiler}")
if(compiler)
  checked("${compiler}" --version)
endif()
foreach(nodes 64 128)
  foreach(rep RANGE 1 3)
    set(patch "${CTEST_BINARY_DIRECTORY}/patch-${nodes}-${rep}.json")
    message(STATUS "MM-f available-only nodes=${nodes}, rep=${rep}, configuration=Release")
    checked("${CTEST_BINARY_DIRECTORY}/mm_f_probe" "${nodes}" available-only
      "${repo}/tests/fixtures/patch_shapes/no-config.json" "${patch}")
    file(SHA256 "${patch}" digest)
    message(STATUS "MM-f patch SHA256 ${digest}")
  endforeach()
endforeach()
