# Opt-in via -DCMAKE_PROJECT_INCLUDE=.../bench/mm_f/hook.cmake.
if(PROJECT_NAME STREQUAL "WirescapeNative" AND CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  function(mm_f_add_target)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
      message(FATAL_ERROR "MM-f RSS probe requires Linux")
    endif()
    get_filename_component(repo "${CMAKE_SOURCE_DIR}/.." ABSOLUTE)
    set(loader "${repo}/host/document/runtime_patch.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${loader}")
    file(READ "${loader}" contents)
    string(REGEX MATCHALL "modules\\.size\\(\\)<=64" matches "${contents}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "MM-f loader cap seam drifted; refuse to widen any other check")
    endif()
    string(REPLACE "modules.size()<=64" "modules.size()<=128" contents "${contents}")
    set(copy "${CMAKE_BINARY_DIR}/mm_f_runtime_patch.cpp")
    file(WRITE "${copy}" "${contents}")
    add_executable(mm_f_probe "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/probe.cpp" "${copy}")
    target_include_directories(mm_f_probe PRIVATE "${repo}/host/document")
    target_link_libraries(mm_f_probe PRIVATE wirescape_app_engine nlohmann_json::nlohmann_json)
  endfunction()
  cmake_language(DEFER CALL mm_f_add_target)
endif()
