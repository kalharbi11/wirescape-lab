{
  "SPDX-License-Identifier": "GPL-3.0-only",
  "name": "OB-a1 shape groove-v2",
  "format": "wirescape.native.patch",
  "version": 2,
  "settings": {
    "sample_rate": 48000,
    "max_block_frames": 128,
    "max_channels": 16,
    "feedback_block": 32,
    "seed": 42,
    "timing_mode": "immediate"
